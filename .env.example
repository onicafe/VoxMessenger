# Environment Variables — B.L.A.S.T. Messenger
# Copy this file to .env and fill in your values. Never commit .env to version control.

# ─── Supabase ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── GOV.br OAuth2 ────────────────────────────────────────────────────────────
# Sandbox: https://sso.staging.acesso.gov.br
# Production: https://sso.acesso.gov.br
EXPO_PUBLIC_GOVBR_CLIENT_ID=your-govbr-client-id
EXPO_PUBLIC_GOVBR_REDIRECT_URI=blast://auth/callback
EXPO_PUBLIC_GOVBR_ENV=sandbox

# ─── Legal Hold (SERVER-SIDE ONLY — never expose to client) ──────────────────
# LEGAL_HOLD_MASTER_KEY=your-aes-256-key  # Set only in server env / CLI tool

# ─── App Config ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_VERSION=0.1.0.0
EXPO_PUBLIC_APP_ENV=development
